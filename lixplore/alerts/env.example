# Lixplore Alerts settings for local runs.
# Created by `lixplore --alerts init`. Fill in your searches and at least one
# channel, then run `lixplore --alerts test`. On GitHub, set the same names
# under Settings -> Secrets and variables -> Actions instead.
# Guide: https://github.com/pryndor/Lixplore_cli/blob/main/docs/guide/alerts.md

# Searches: one per line, optionally "name | query | sources"
# Several searches: separate with \n inside double quotes
LIXPLORE_QUERIES="GLP-1 | semaglutide AND obesity | pubmed,europepmc\nCRISPR base editing"
LIXPLORE_SOURCES=pubmed,europepmc,arxiv
LIXPLORE_MAX_RESULTS=20
LIXPLORE_LOOKBACK_DAYS=auto
LIXPLORE_ATTACH_FORMAT=csv
LIXPLORE_SEND_WHEN_EMPTY=false

# ---- Delivery: fill any number of channels ----
# Email (Gmail needs an app password)
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVERS=
# SMTP_SERVER=
# SMTP_PORT=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_MESSAGE_THREAD_ID=

# Discord: webhook, or bot token + channel
# DISCORD_WEBHOOK_URL=
# DISCORD_BOT_TOKEN=
# DISCORD_MAIN_CHANNEL_ID=

# Slack: webhook, or bot token + channel
# SLACK_WEBHOOK_URL=
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=

# TEAMS_WEBHOOK_URL=
# GOOGLE_CHAT_WEBHOOK_URL=

# MATRIX_HOMESERVER=https://matrix.org
# MATRIX_ACCESS_TOKEN=
# MATRIX_ROOM_ID=

# WECHAT_WEBHOOK_URL=
# WECHAT_MSG_TYPE=markdown
# FEISHU_WEBHOOK_URL=
# FEISHU_WEBHOOK_SECRET=
# FEISHU_WEBHOOK_KEYWORD=
# DINGTALK_WEBHOOK_URL=
# DINGTALK_SECRET=

# NTFY_URL=https://ntfy.sh/your-topic
# NTFY_TOKEN=
# GOTIFY_URL=
# GOTIFY_TOKEN=
# PUSHOVER_USER_KEY=
# PUSHOVER_API_TOKEN=
# PUSHPLUS_TOKEN=
# PUSHPLUS_TOPIC=
# SERVERCHAN3_SENDKEY=
# ASTRBOT_URL=
# ASTRBOT_TOKEN=

# Custom webhook (n8n / Zapier / Make / IFTTT / Bark ...)
# CUSTOM_WEBHOOK_URLS=
# CUSTOM_WEBHOOK_BEARER_TOKEN=
# CUSTOM_WEBHOOK_BODY_TEMPLATE={"title": $title_json, "body": $content_json}
# WEBHOOK_VERIFY_SSL=true

# Optional: raises NCBI's rate limit only
# PUBMED_EMAIL=
# PUBMED_API_KEY=
